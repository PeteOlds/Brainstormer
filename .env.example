# Copy to .env and fill in. NEVER commit .env.
# Generate secure keys:
# SECRET_KEY / JWT_SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(32))"
# FERNET_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# Flask
SECRET_KEY=your-super-secret-key-min-32-chars
FLASK_ENV=development

# Database
DB_PASSWORD=secure-postgres-password
DATABASE_URL=postgresql://app:${DB_PASSWORD}@localhost:5432/brainstormer

# Redis
REDIS_URL=redis://localhost:6379

# Ollama
OLLAMA_BASE_URL=http://localhost:11434

# App
APP_BASE_URL=http://localhost:8000

# Slack (Phase 3a: auto-post new ideas; empty disables)
SLACK_BOT_TOKEN=

# Auth (JWT) — access tokens last 24h (see PRD §8.3)
JWT_SECRET_KEY=your-32-byte-base64-encoded-secret
JWT_ACCESS_TOKEN_EXPIRES=86400
JWT_REFRESH_TOKEN_EXPIRES=604800

# Encryption (Fernet)
FERNET_KEY=your-32-byte-base64-encoded-key

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Rate Limiting
RATE_LIMIT_STORAGE_URL=redis://localhost:6379/2